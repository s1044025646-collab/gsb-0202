{
  "name": "nurbs-backend",
  "version": "1.0.0",
  "description": "本地 NURBS 曲线求值与保形节点细化后端（TypeScript + Node.js + SQLite）",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "nurbs": "dist/cli/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/test/nurbs.test.ts",
    "start": "node dist/server/index.js",
    "dev": "tsx src/server/index.ts",
    "demo": "tsx src/demo/demo.ts",
    "cli": "tsx src/cli/cli.ts"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
